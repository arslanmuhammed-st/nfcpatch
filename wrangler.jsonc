{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "nfcpatch",
	"workers_dev": true,
	"compatibility_date": "2026-08-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "nfcpatch"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"routes": [
		{
			"pattern": "nfcpatch.link",
			"custom_domain": true
		},
		{
			"pattern": "www.nfcpatch.link",
			"custom_domain": true
		}
	],
	"vars": {
		"NEXT_PUBLIC_SUPABASE_URL": "https://stfrajsripuepqdlsrfl.supabase.co",
		"NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_bUAgHp5x5lnpanOJp3syrQ_8avXYGjz",
		"NEXT_PUBLIC_SITE_URL": "https://nfcpatch.link"
	}
}
